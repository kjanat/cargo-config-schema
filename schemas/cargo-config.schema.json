{
  "$id": "https://raw.githubusercontent.com/kjanat/cargo-config-schema/master/schemas/cargo-config.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Audited against https://github.com/rust-lang/cargo/blob/cc5596f058e623d22be718adf541a9bd766d9417/doc/book/src/reference/config.md and source. Unstable options are labelled; defaults depend on Cargo version, environment and merged configuration. Unknown keys remain permitted for forward compatibility.",
  "$defs": {
    "includeEntry": {
      "examples": [
        "shared.toml",
        {
          "path": "optional-local.toml",
          "optional": true
        }
      ],
      "oneOf": [
        {
          "description": "Path to a Cargo configuration file to include.",
          "type": "string",
          "pattern": "\\.toml$"
        },
        {
          "description": "Inline include table. Use optional = true to silently ignore missing files.",
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "\\.toml$"
            },
            "optional": {
              "default": false,
              "type": "boolean"
            }
          },
          "x-tombi-table-keys-order": {
            "properties": "schema"
          }
        }
      ]
    }
  },
  "title": "cargo configuration",
  "description": "Cargo configuration file schema for .cargo/config.toml and credentials.toml after TOML parsing. Section-specific subschemas live in sibling files (alias.schema.json, build.schema.json, ..., term.schema.json) and are referenced from this metaschema. A flattened single-file equivalent is generated at ../cargo-config.json by cargo-schema-bundle for validators that do not follow cross-file $refs (e.g. tombi).\n\n[Cargo documentation](https://doc.rust-lang.org/cargo/reference/config.html)",
  "examples": [
    {
      "build": {
        "jobs": 4,
        "target": "x86_64-unknown-linux-gnu",
        "rustflags": [
          "-C",
          "target-cpu=native"
        ]
      },
      "term": {
        "color": "auto",
        "progress": {
          "when": "auto"
        }
      }
    },
    {
      "include": [
        "shared.toml",
        {
          "path": "local-overrides.toml",
          "optional": true
        }
      ],
      "env": {
        "OPENSSL_DIR": {
          "value": "vendor/openssl",
          "relative": true
        },
        "RUST_LOG": "info"
      }
    },
    {
      "registries": {
        "my-registry": {
          "index": "https://example.com/git/index",
          "credential-provider": "cargo:token"
        },
        "crates-io": {
          "protocol": "sparse"
        }
      },
      "registry": {
        "default": "my-registry",
        "global-credential-providers": [
          "cargo:token"
        ]
      }
    },
    {
      "target": {
        "x86_64-unknown-linux-gnu": {
          "linker": "clang",
          "runner": [
            "qemu-x86_64",
            "-L",
            "/usr/x86_64-linux-gnu"
          ],
          "rustflags": [
            "-C",
            "link-arg=-fuse-ld=lld"
          ]
        },
        "thumbv7m-none-eabi": {
          "linker": "arm-none-eabi-gcc"
        }
      }
    }
  ],
  "type": "object",
  "properties": {
    "include": {
      "description": "Additional Cargo configuration files to include. Paths are relative to the including configuration file and must end with .toml.\n\n[Cargo documentation](https://doc.rust-lang.org/cargo/reference/config.html#include)",
      "type": "array",
      "items": {
        "$ref": "#/$defs/includeEntry"
      }
    },
    "paths": {
      "description": "Local package paths used as dependency overrides.\n\n[Cargo documentation](https://doc.rust-lang.org/cargo/reference/config.html#paths)",
      "examples": [
        [
          "../local-crate"
        ],
        [
          "/path/to/override"
        ]
      ],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "alias": {
